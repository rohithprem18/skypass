__pycache__/
*.pyc
*.egg-info/
.venv/
venv/

# Cached Open-Meteo API responses. Large, and regenerated on demand.
cache/

# LaTeX build products, so final_paper/ieee and final_paper/springer hold only
# what Overleaf or the journal system needs to build them.
final_paper/*/*.aux
final_paper/*/*.log
final_paper/*/*.out
final_paper/*/*.bbl
final_paper/*/*.blg
final_paper/*/*.synctex.gz
final_paper/*/*.fls
final_paper/*/*.fdb_latexmk

# Preview renders; the vector PDFs are the ones the paper uses.
figures/*.png

# NOTE: results/, figures/*.pdf, generated/, final_paper/ and tle_archive/ are all
# tracked on purpose. They are the exact inputs the paper was built from, and
# CelesTrak serves only current elements -- without the dated archive, a past
# prediction cannot be reproduced.
.spacetrack

# Credentials -- never commit.
.env
.env.local
.env.*.local

# Node / Vite build products for the web UI. dist/ is generated by
# `npm run build`; the Python server falls back to webapp/static/ without it.
webapp/ui/node_modules/
webapp/ui/dist/

# Document & presentation review files
*.docx
*.pptx

